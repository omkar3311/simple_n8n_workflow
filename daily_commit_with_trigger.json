          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    message: \"Daily learning note #\" + $json.number,\n    content: $json.encodedContent,\n    sha: $json.sha\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        976,
        48
      ],
      "id": "17f6d1b4-99f5-4390-853f-42c9a0efd1f4",
      "name": "commit to github",
      "credentials": {
        "githubApi": {
          "id": "daqy4A8eRgNumxY5",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const github = $input.item.json;\n\n// Get the current note from Loop Over Items\nconst note = $('Loop Over Items').item.json;\n\n// GitHub content is Base64\nconst currentContent = Buffer\n  .from(github.content.replace(/\\s/g, ''), 'base64')\n  .toString('utf8');\n\n// Text to append\nconst appendText = `\n\n## ${note.number}. ${note.title}\n\n${note.content}\n`;\n\n// Full new file\nconst updatedContent = currentContent + appendText;\n\n// Encode the ENTIRE updated file as Base64\nconst encodedContent = Buffer\n  .from(updatedContent, 'utf8')\n  .toString('base64');\n\nreturn {\n  json: {\n    number: note.number,\n    title: note.title,\n    sha: github.sha,\n    filePath: github.path,\n    encodedContent: encodedContent\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
