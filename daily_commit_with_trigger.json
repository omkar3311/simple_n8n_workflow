        "method": "PUT",
        "url": "=https://api.github.com/repos/omkar3311/simple_n8n_workflow/contents/{{$json.filePath}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
